# Configurações do Firebase (Console > Configurações do projeto > Seus apps > Web)
# Em produção esses valores vêm das secrets do GitHub (pipeline de deploy).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Caminho base do app (deixe vazio/'/' em dev; a pipeline define /cash-organizer-web/)
VITE_BASE_PATH=/

# Opcional: desenvolvimento local contra o emulador do Firestore
# (rode "npx firebase-tools emulators:start --only firestore" no repo de backend)
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
